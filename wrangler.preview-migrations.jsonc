// Only for applying migrations to the shared PREVIEW database:
//   npx wrangler d1 migrations apply DB --remote --config wrangler.preview-migrations.jsonc
// Keep database_name/database_id identical to previews.d1_databases in wrangler.jsonc.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "bearmatics",
  "compatibility_date": "2026-11-09",
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "bearmatics-preview",
      "database_id": "00000000-0000-0000-0000-000000000002",
      "migrations_dir": "migrations"
    }
  ]
}
