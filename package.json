{
  "name": "bearmatics",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^26.12.1"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && tsc --noEmit -p worker && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "vitest run",
    "test:server": "vitest run --config vitest.server.config.ts",
    "test:e2e": "playwright test",
    "deploy:check": "wrangler deploy --dry-run",
    "deploy": "wrangler d1 migrations apply DB --remote && wrangler deploy",
    "deploy:preview": "wrangler d1 migrations apply DB --remote --config wrangler.preview-migrations.jsonc && wrangler preview",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "types:worker": "wrangler types worker/worker-configuration.d.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "oxlint"
  },
  "dependencies": {
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/node": "26.6.6",
    "typescript": "7.0.2",
    "vite": "8.3.7",
    "vitest": "5.1.0",
    "jsdom": "31.0.0",
    "@testing-library/react": "16.3.3",
    "@testing-library/jest-dom": "7.0.1",
    "@playwright/test": "1.65.0",
    "prettier": "3.10.1",
    "oxlint": "1.93.0",
    "wrangler": "4.158.0"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "workerd@1.20261104.1": true
  }
}
