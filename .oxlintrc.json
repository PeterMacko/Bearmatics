{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "react", "oxc", "unicorn"],
  "categories": {
    "correctness": "error"
  },
  "rules": {
    "no-unused-vars": "error",
    "react/rules-of-hooks": "error",
    "react/exhaustive-deps": "error"
  },
  "ignorePatterns": [
    "dist/**",
    "public/**",
    ".wrangler/**",
    "test-results/**",
    "playwright-report/**",
    "worker/worker-configuration.d.ts"
  ]
}
