{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "bearmatics",
  "main": "worker/index.ts",
  "compatibility_date": "2026-11-09",
  // Static app via the ASSETS binding. The server script runs first for every request so plain
  // http is redirected to https (SCRUM-198); /api is answered by the script (SCRUM-96).
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  // Live database. Previews use their own database (previews block below), local dev a local file.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "bearmatics",
      "database_id": "8489f23b-69cf-4e11-a377-316189ddb584",
      "migrations_dir": "migrations"
    }
  ],
  // Google sign-in client ID (not secret). The secret GOOGLE_CLIENT_SECRET is set in Cloudflare.
  "vars": { "GOOGLE_CLIENT_ID": "182275285165-b98ddo557hgpj0m19gbi1kvcftsspfdh.apps.googleusercontent.com" },
  "observability": {
    "logs": {
      "enabled": true,
      "invocation_logs": true,
      "persist": true
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.2
    }
  },
  "previews": {
    "vars": { "GOOGLE_CLIENT_ID": "182275285165-b98ddo557hgpj0m19gbi1kvcftsspfdh.apps.googleusercontent.com" },
    "d1_databases": [
      {
        "binding": "DB",
        "database_name": "bearmatics-preview",
        "database_id": "e62f4a22-742c-4247-a32c-19daf51e4d8f",
        "migrations_dir": "migrations"
      }
    ]
  }
}
